# .gitignore for Algo Trading Alert System
# ============================================

# ============ Python Bytecode & Build Artifacts ============
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ============ Virtual Environments ============
venv/
ENV/
env/
.venv/
myenv/
mywinenv/
*env/

# ============ IDE & Editor ============
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*

# ============ Data Files (generated at runtime) ============
*.xlsx
*.csv
*.json
!config.json
!data/thematic_portfolio.json
!sample_tickers.csv
# Reference data that results depend on must be versioned
!data/nse_sector_map.json
!data/nifty500_historical_constituents.json
!data/nifty500_wayback_raw.json
!data/shift_reference_returns.csv
# NSE engine archives, parquet store and run directories (large, regenerable)
data/nse_engine/
*.log
logs/
*.jsonl

# ============ OS Files ============
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============ Jupyter ============
.ipynb_checkpoints/
*.ipynb

# ============ ML Models & Serialised Data ============
.cache/
models/
data/rl_models/
*.h5
*.pkl
*.joblib
*.zip

# ============ Secrets & Credentials ============
.env
.env.*
*.pem
*.key
secrets/
auth/credentials.yaml
credentials.txt

# ============ ChromaDB / Vector Stores (runtime-generated) ============
chroma_store/
data/chroma_db/

# ============ RAG Pipeline Runtime Data ============
data/retrieval_log.jsonl
rag_pipeline/data/retrieval_log.jsonl
data/rag_uploads/

# ============ SQLite Databases ============
*.sqlite3

# ============ Backup & Temp Files ============
*_backup*
*.bak

# ============ Testing & Docs ============
.pytest_cache/
.coverage
htmlcov/
.tox/
docs/_build/
site/

# ============ Financial ML (runtime-generated caches & outputs) ============
financial_ML/_cache/
financial_ML/_output/

# ============ Test & Tune Trading System (runtime-generated caches & outputs) ============
testune_trade_sys/_cache/
testune_trade_sys/_output/

# ============ Node.js / Next.js Frontend ============
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
.next/
out/
