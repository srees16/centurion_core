# Hugging Face Spaces — Docker SDK
# Free tier: 2 vCPU, 16 GB RAM, 50 GB disk
# Docs: https://huggingface.co/docs/hub/spaces-sdks-docker
FROM python:3.11-slim

# HF Spaces requires the app to run as non-root user (uid 1000)
RUN useradd -m -u 1000 user

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/home/user

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    build-essential \
    curl \
    dos2unix \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
# Both: requirements.txt starts with `-r requirements-core.txt`, so the
# include must be in the build context or pip cannot open it.
COPY requirements.txt requirements-core.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Fix Windows CRLF line endings in shell scripts & create writable dirs
RUN dos2unix /app/deployment/start.sh 2>/dev/null || sed -i 's/\r$//' /app/deployment/start.sh \
    && cp /app/deployment/start.sh /app/start.sh \
    && chmod +x /app/start.sh \
    && mkdir -p /app/data/chroma_db /app/data/rag_uploads /app/data/bhavcopy_cache /app/data/event_logs \
    && chown -R user:user /app

# Switch to non-root user (HF Spaces requirement)
USER user

# HF Spaces exposes port 7860 by default
EXPOSE 7860

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl --fail http://localhost:7860/health || exit 1

CMD ["bash", "/app/start.sh"]
