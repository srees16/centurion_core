# Secrets for a development laptop.  Copy to .env (gitignored) and fill only what you need:
#   cp .env.example .env && chmod 600 .env
# config.py loads .env automatically.  NEVER commit .env: this repository is public.
# GitHub / Hugging Face secrets are write-only, so these values come from wherever you keep
# them (password manager, the Neon / Zerodha / email consoles).  Leave a line empty to skip it.

# --- Paper-trading state (Neon Postgres): dashboards, scorecard SC1b, paper checks.
#     A read-only role is enough for development.
CENTURION_DATABASE_URL=

# --- Zerodha Kite Connect: only for scripts that talk to the broker (orders, quotes, login).
#     The daily login itself stays manual (never automated).
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
CENTURION_KITE_TOKEN_KEY=

# --- Alerts and reports (email, dead-man's switch): only to test the alert path locally.
CENTURION_EMAIL_HOST=
CENTURION_EMAIL_PORT=
CENTURION_EMAIL_USER=
CENTURION_EMAIL_PASS=
CENTURION_HEALTHCHECK_URL=
CENTURION_HEARTBEAT_URL=

# --- GitHub workflow dispatch (triggering the paper workflow from scripts).
CENTURION_GH_DISPATCH_TOKEN=

# --- API server (run_api.py).
CENTURION_API_SECRET_KEY=

# --- Optional app features (RAG / assistants).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
